{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-voiceinput-frontend",
  "version": "0.1.0",
  "identifier": "com.kawar.voice-input-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ai-voiceinput-frontend",
        "width": 600,
        "height": 700,
        "minWidth": 500,
        "minHeight": 500,
        "visible": false,
        "decorations": true,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "",
        "width": 300,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "resizable": false,
        "shadow": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:13305 http://localhost:13305 https:; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese"]
      },
      "wix": {
        "language": ["ja-JP"]
      }
    }
  }
}
